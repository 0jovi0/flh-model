+// ---------------------------------------------------------------------------
+// The driver: one trace step -> one call on the Rust tracker
+// ---------------------------------------------------------------------------
+
+struct TrackerDriver {
+    cluster_info: Arc<ClusterInfo>,
+    /// The tracker under test; a new one at the start of every trace.
+    tracker: Option<ParentReadyTracker>,
+    /// First and last slot of the model instance.
+    slots: (Slot, Slot),
+    /// Every block of the model instance, the root included.
+    blocks: BTreeSet<QBlock>,
+    /// Every ParentReady event the tracker has emitted in this trace.
+    events: Vec<QEvent>,
+    /// A call hit the tracker's assert.
+    panicked: bool,
+    leader_before: BTreeMap<Slot, QChoice>,
+    /// Trace and step counters, only for the `AG_TRACE` output.
+    trace_no: usize,
+    step_no: usize,
+}
+
+impl TrackerDriver {
+    fn new() -> Self {
+        Self {
+            cluster_info: get_cluster_info(Keypair::new()),
+            tracker: None,
+            slots: (0, 0),
+            blocks: BTreeSet::new(),
+            events: vec![],
+            panicked: false,
+            leader_before: BTreeMap::new(),
+            trace_no: 0,
+            step_no: 0,
+        }
+    }
+
+    /// Prints one line of the `AG_TRACE` output.
+    fn note(&self, what: impl fmt::Display) {
+        if trace_level() > 0 {
+            eprintln!("  {what}");
+        }
+    }
+
+    fn tracker(&self) -> Result<&ParentReadyTracker> {
+        self.tracker
+            .as_ref()
+            .ok_or_else(|| anyhow!("the trace did not start with an init action"))
+    }
+
+    /// Start of a trace: a fresh tracker rooted at `root`, as the model's
+    /// `newTracker` (root block certified, ready parent for the next slot).
+    fn init(
+        &mut self,
+        root: QBlock,
+        last: Slot,
+        blocks: BTreeSet<QBlock>,
+        count: usize,
+    ) -> Result {
+        check_ids(&blocks, count)?;
+        ensure!(blocks.contains(&root), "the root {root} is not a block of the instance");
+        self.blocks = blocks;
+        let parent_ready = (root.slot.checked_add(1).unwrap(), root.to_block());
+        self.tracker = Some(ParentReadyTracker::new(
+            self.cluster_info.clone(),
+            root.slot,
+            parent_ready,
+        ));
+        self.slots = (root.slot, last);
+        self.events.clear();
+        self.panicked = false;
+        self.note(format_args!(
+            "call:  ParentReadyTracker::new(root = {}, parent ready = ({}, {root}))",
+            root.slot,
+            root.slot.saturating_add(1)
+        ));
+        self.leader_before = self.ask_leader()?;
+        Ok(())
+    }
+
+    /// A block named by a step must be one of the instance's blocks.
+    fn known(&self, block: QBlock) -> Result {
+        ensure!(
+            self.blocks.contains(&block),
+            "the step names {block}, which is not a block of the instance"
+        );
+        Ok(())
+    }
+
+    /// `block_production_parent` for every slot of the instance.
+    fn ask_leader(&self) -> Result<BTreeMap<Slot, QChoice>> {
+        let tracker = self.tracker()?;
+        (self.slots.0..=self.slots.1)
+            .map(|slot| {
+                let choice = match tracker.block_production_parent(slot) {
+                    BlockProductionParent::MissedWindow => QChoice::MissedWindow,
+                    BlockProductionParent::ParentNotReady => QChoice::ParentNotReady,
+                    BlockProductionParent::Parent(block) => {
+                        QChoice::Parent(QBlock::from_block(&block)?)
+                    }
+                };
+                Ok((slot, choice))
+            })
+            .collect()
+    }
+
+    /// One call on the tracker. A panic inside the call is caught and
+    /// remembered; after it no further call is made, as the real process
+    /// would have stopped.
+    fn call(
+        &mut self,
+        what: String,
+        f: impl FnOnce(&mut ParentReadyTracker, &mut Vec<VotorEvent>),
+    ) -> Result {
+        if self.panicked {
+            self.note(format_args!("call:  {what} not made, the tracker has panicked"));
+            return Ok(());
+        }
+        self.note(format_args!("call:  {what}"));
+        let tracker = self
+            .tracker
+            .as_mut()
+            .ok_or_else(|| anyhow!("the trace did not start with an init action"))?;
+        let mut emitted = vec![];
+        if catch_unwind(AssertUnwindSafe(|| f(tracker, &mut emitted))).is_err() {
+            self.panicked = true;
+            self.note("       the call panicked");
+            return Ok(());
+        }
+        let mut returned = vec![];
+        for event in emitted {
+            let VotorEvent::ParentReady { slot, parent_block } = event else {
+                bail!("the tracker emitted an event that is not ParentReady")
+            };
+            returned.push(QEvent {
+                slot,
+                parent: QBlock::from_block(&parent_block)?,
+            });
+        }
+        self.note(format_args!(
+            "       events returned, in the tracker's order: {}",
+            list(returned.iter().map(|event| format!("{} <- {}", event.slot, event.parent)))
+        ));
+        self.events.extend(returned);
+        Ok(())
+    }
+
+    fn certified(&mut self, block: QBlock) -> Result {
+        self.known(block)?;
+        self.call(
+            format!("add_new_notar_fallback_or_stronger({block})"),
+            |tracker, events| tracker.add_new_notar_fallback_or_stronger(block.to_block(), events),
+        )
+    }
+
+    fn skip(&mut self, slot: Slot) -> Result {
+        self.call(format!("add_new_skip({slot})"), |tracker, events| {
+            tracker.add_new_skip(slot, events)
+        })
+    }
+
+    fn root(&mut self, block: QBlock) -> Result {
+        self.known(block)?;
+        self.call(format!("set_root({})", block.slot), |tracker, _| {
+            tracker.set_root(block.slot)
+        })
+    }
+}
+
+impl Driver for TrackerDriver {
+    type State = View;
+
+    fn step(&mut self, step: &Step) -> Result {
+        // Before any action but the first, record what each slot's leader
+        // would be told. The model records the same in `leaderBefore`.
+        let first = step.action_taken.starts_with("init");
+        if self.tracker.is_some() && !self.panicked && !first {
+            self.leader_before = self.ask_leader()?;
+        }
+        if first {
+            self.trace_no = self.trace_no.saturating_add(1);
+            self.step_no = 0;
+        } else {
+            self.step_no = self.step_no.saturating_add(1);
+        }
+        if trace_level() > 0 {
+            if first {
+                eprintln!(
+                    "\n== trace {}. Blocks are written slot.id; the id stands in for the \
+                     32-byte block hash.",
+                    self.trace_no
+                );
+            }
+            eprintln!(
+                "\n[trace {} step {}] model action: {}",
+                self.trace_no, self.step_no, step.action_taken
+            );
+            if matches!(step.action_taken.as_str(), "certify" | "skipSlot" | "finalize") {
+                eprintln!("  call:  none (the network produced something the node has not seen)");
+            }
+        }
+        switch!(step {
+            // start of a trace
+            initC(root: QBlock, last: Slot, blocks: BTreeSet<QBlock>, count: usize) => {
+                self.init(root, last, blocks, count)?
+            },
+            initRandomIdsC(root: QBlock, last: Slot, blocks: BTreeSet<QBlock>, count: usize) => {
+                self.init(root, last, blocks, count)?
+            },
+            // the node receives a certificate, or moves its root
+            deliverCertified(b: QBlock) => self.certified(b)?,
+            deliverSkip(s: Slot) => self.skip(s)?,
+            advanceRoot(b: QBlock) => self.root(b)?,
+            // the same three calls, with any argument (stepRaw)
+            nodeCertified(b: QBlock) => self.certified(b)?,
+            nodeSkip(s: Slot) => self.skip(s)?,
+            nodeRoot(b: QBlock) => self.root(b)?,
+            // the network produces something; the node has not seen it yet
+            certify => (),
+            skipSlot => (),
+            finalize => (),
+        })
+    }
+}
