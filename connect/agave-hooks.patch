diff --git a/votor/src/consensus_pool/parent_ready_tracker/quint_connect.rs b/votor/src/consensus_pool/parent_ready_tracker/quint_connect.rs
new file mode 100644
index 0000000..445c0a7
--- /dev/null
+++ b/votor/src/consensus_pool/parent_ready_tracker/quint_connect.rs
@@ -0,0 +1,756 @@
+//! ag-model hook.
+//!
+//! Model-based test of `ParentReadyTracker` against the Quint model in
+//! `/opt/ag-model/spec` (`tracker.qnt`, wrapped by `tracker_connect.qnt`).
+//!
+//! How one test below works:
+//!
+//! 1. `#[quint_run]` runs `quint run --mbt` on one instance of the model.
+//!    Quint writes every random run as a trace: a list of states, each tagged
+//!    with the action that produced it and the values that action picked.
+//! 2. For every state of every trace, [`TrackerDriver::step`] gets the action
+//!    name and its picks and makes the matching call on the Rust tracker.
+//! 3. After each step a [`View`] is built twice: from the model's state in
+//!    the trace ([`State::from_spec`]) and from the Rust tracker
+//!    ([`State::from_driver`]). If the two differ, the test fails and prints
+//!    the diff and the seed.
+//!
+//! This is a child module of the tracker, so it reads the tracker's private
+//! fields directly.
+//!
+//! Run from `/opt/ag-model/agave`:
+//!   `/opt/ag-model/t test -p agave-votor --features agave-unstable-api --lib quint_connect`
+//!
+//! A failure prints `Reproduce this error with QUINT_SEED=<seed>`; put that
+//! variable in front of the same command to replay the same traces.
+//!
+//! To watch both sides, set `AG_TRACE` and pass `--nocapture`. For every step
+//! this prints the call made on the Rust tracker, the events it returned, and
+//! the two views that are compared (`model:` from the trace, `rust:` from the
+//! tracker). `AG_TRACE=2` adds the tracker's own `Debug` output. The test
+//! `one_short_trace` keeps the output to one trace of 20 steps:
+//!   `AG_TRACE=1 /opt/ag-model/t test -p agave-votor --features agave-unstable-api \
+//!        --lib quint_connect::one_short_trace -- --nocapture`
+
+// Named imports, not `super::*`: a glob would bring this module's own name
+// into scope, where it would clash with the `quint_connect` crate.
+use {
+    super::{
+        Arc, Block, BlockProductionParent, ClusterInfo, ParentReadyTracker, Slot, VotorEvent,
+    },
+    crate::tests::get_cluster_info,
+    agave_votor_messages::consensus_message::BlockId,
+    anyhow::{anyhow, bail, ensure},
+    itf::{value::Record, Value},
+    quint_connect::*,
+    serde::{de::DeserializeOwned, Deserialize},
+    solana_hash::Hash,
+    solana_keypair::Keypair,
+    std::{
+        collections::{BTreeMap, BTreeSet},
+        fmt,
+        panic::{catch_unwind, AssertUnwindSafe},
+    },
+};
+
+/// Level of the `AG_TRACE` environment variable; 0 when it is not set.
+fn trace_level() -> u8 {
+    std::env::var("AG_TRACE")
+        .ok()
+        .map(|level| level.parse().unwrap_or(1))
+        .unwrap_or(0)
+}
+
+// ---------------------------------------------------------------------------
+// The model's values, as they appear in a trace
+// ---------------------------------------------------------------------------
+
+/// A block as the model names it: a slot and a small numeric id.
+#[derive(Deserialize, Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+struct QBlock {
+    slot: Slot,
+    id: u64,
+}
+
+impl QBlock {
+    /// The real block for a model block. The id goes big-endian into the last
+    /// 8 bytes of the 32-byte hash, so real blocks sort like model
+    /// blocks (slot first, then id) and `min()` picks the same one.
+    fn to_block(self) -> Block {
+        let mut bytes = [0u8; 32];
+        bytes[24..].copy_from_slice(&self.id.to_be_bytes());
+        Block {
+            slot: self.slot,
+            block_id: BlockId::from(Hash::new_from_array(bytes)),
+        }
+    }
+
+    fn from_block(block: &Block) -> Result<Self> {
+        let bytes = block.block_id.as_bytes();
+        ensure!(
+            bytes[..24].iter().all(|byte| *byte == 0),
+            "block id was not made by this driver: {block:?}"
+        );
+        let mut id = [0u8; 8];
+        id.copy_from_slice(&bytes[24..]);
+        Ok(Self {
+            slot: block.slot,
+            id: u64::from_be_bytes(id),
+        })
+    }
+}
+
+/// What the tracker knows about one slot (`Status` in the model,
+/// `ParentReadyStatus` in the Rust).
+#[derive(Deserialize, Debug, Default, PartialEq, Eq)]
+struct QStatus {
+    skip: bool,
+    certified: BTreeSet<QBlock>,
+    parents: BTreeSet<QBlock>,
+}
+
+/// A ParentReady event.
+#[derive(Deserialize, Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+struct QEvent {
+    slot: Slot,
+    parent: QBlock,
+}
+
+/// What a leader is told (`Choice` in the model, `BlockProductionParent` in
+/// the Rust).
+#[derive(Deserialize, Debug, Clone, Copy, PartialEq, Eq)]
+#[serde(tag = "tag", content = "value")]
+enum QChoice {
+    MissedWindow,
+    ParentNotReady,
+    Parent(QBlock),
+}
+
+impl fmt::Display for QBlock {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        write!(f, "{}.{}", self.slot, self.id)
+    }
+}
+
+impl fmt::Display for QChoice {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        match self {
+            Self::MissedWindow => write!(f, "MissedWindow"),
+            Self::ParentNotReady => write!(f, "ParentNotReady"),
+            Self::Parent(block) => write!(f, "Parent({block})"),
+        }
+    }
+}
+
+fn list<T: fmt::Display>(items: impl IntoIterator<Item = T>) -> String {
+    let items: Vec<String> = items.into_iter().map(|item| item.to_string()).collect();
+    format!("[{}]", items.join(", "))
+}
+
+/// The model's tracker record (`tr`).
+#[derive(Deserialize, Debug)]
+struct QTracker {
+    st: BTreeMap<Slot, QStatus>,
+    root: Slot,
+    highest: Slot,
+    events: Vec<QEvent>,
+    panicked: bool,
+}
+
+// ---------------------------------------------------------------------------
+// What is compared after every step
+// ---------------------------------------------------------------------------
+
+/// The state both sides are reduced to before they are compared.
+#[derive(Debug, Default, PartialEq, Eq)]
+struct View {
+    /// The fifth-block assert fired. Once it has, nothing else is compared:
+    /// the real process would be dead, and the Rust has already pushed the
+    /// block the model refused.
+    panicked: bool,
+    root: Slot,
+    highest: Slot,
+    /// Per slot. A slot with nothing recorded is left out on both sides (the
+    /// model keeps an empty entry for every slot, the Rust keeps a sparse map).
+    st: BTreeMap<Slot, QStatus>,
+    /// Every ParentReady event emitted so far, sorted. Equal at every step
+    /// means each call emitted the same events; the order inside one call is
+    /// not compared.
+    events: Vec<QEvent>,
+    /// What the leader of each slot would have been told just before this
+    /// step.
+    leader_before: BTreeMap<Slot, QChoice>,
+}
+
+impl View {
+    fn dead() -> Self {
+        Self {
+            panicked: true,
+            ..Self::default()
+        }
+    }
+}
+
+/// How a view is printed under `AG_TRACE`. Blocks are written `slot.id`.
+impl fmt::Display for View {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        if self.panicked {
+            return write!(f, "panicked");
+        }
+        write!(f, "root={} highest={}", self.root, self.highest)?;
+        for (slot, status) in &self.st {
+            write!(
+                f,
+                "\n      slot {slot}: skip={} certified={} parents={}",
+                status.skip,
+                list(&status.certified),
+                list(&status.parents)
+            )?;
+        }
+        let events = self
+            .events
+            .iter()
+            .map(|event| format!("{} <- {}", event.slot, event.parent));
+        write!(f, "\n      events (sorted): {}", list(events))?;
+        let leader = self
+            .leader_before
+            .iter()
+            .map(|(slot, choice)| format!("{slot}: {choice}"));
+        write!(f, "\n      leader before the step: {}", list(leader))
+    }
+}
+
+/// Reads the model variable whose name ends in `suffix`. In a trace the
+/// variables are named `<instance>::tracker_connect::<name>`.
+fn var<T: DeserializeOwned>(vars: &Record, suffix: &str) -> Result<T> {
+    let mut found = vars.iter().filter(|(name, _)| name.ends_with(suffix));
+    let (_, value) = found
+        .next()
+        .ok_or_else(|| anyhow!("no model variable ending in {suffix}"))?;
+    ensure!(found.next().is_none(), "several model variables end in {suffix}");
+    Ok(T::deserialize(value.clone())?)
+}
+
+impl State<TrackerDriver> for View {
+    /// The view of the model's state in the trace.
+    fn from_spec(value: Value) -> Result<Self> {
+        let Value::Record(vars) = value else {
+            bail!("the model state is not a record")
+        };
+        let tr: QTracker = var(&vars, "::tr")?;
+        let view = if tr.panicked {
+            Self::dead()
+        } else {
+            let mut events = tr.events;
+            events.sort();
+            Self {
+                panicked: false,
+                root: tr.root,
+                highest: tr.highest,
+                st: tr
+                    .st
+                    .into_iter()
+                    .filter(|(_, status)| *status != QStatus::default())
+                    .collect(),
+                events,
+                leader_before: var(&vars, "::leaderBefore")?,
+            }
+        };
+        if trace_level() > 0 {
+            eprintln!("  model: {view}");
+        }
+        Ok(view)
+    }
+
+    /// The view of the Rust tracker.
+    fn from_driver(driver: &TrackerDriver) -> Result<Self> {
+        let view = Self::of_tracker(driver)?;
+        if trace_level() > 0 {
+            eprintln!("  rust:  {view}");
+        }
+        if trace_level() > 1 {
+            eprintln!("  rust, as the tracker prints itself: {:#?}", driver.tracker()?);
+        }
+        Ok(view)
+    }
+}
+
+impl View {
+    fn of_tracker(driver: &TrackerDriver) -> Result<Self> {
+        if driver.panicked {
+            return Ok(Self::dead());
+        }
+        let tracker = driver.tracker()?;
+        let mut st = BTreeMap::new();
+        for (slot, status) in &tracker.slot_statuses {
+            let certified = to_set(&status.notar_fallbacks)?;
+            let parents = to_set(&status.parents_ready)?;
+            // Checks the model cannot express, because it keeps sets.
+            ensure!(
+                certified.len() == status.notar_fallbacks.len(),
+                "duplicate block in notar_fallbacks of slot {slot}: {:?}",
+                status.notar_fallbacks
+            );
+            ensure!(
+                parents.len() == status.parents_ready.len(),
+                "duplicate block in parents_ready of slot {slot}: {:?}",
+                status.parents_ready
+            );
+            for block in &status.notar_fallbacks {
+                ensure!(
+                    tracker.has_notar_fallback_or_stronger(*block),
+                    "has_notar_fallback_or_stronger denies {block:?}"
+                );
+            }
+            let status = QStatus {
+                skip: status.skip,
+                certified,
+                parents,
+            };
+            if status != QStatus::default() {
+                st.insert(*slot, status);
+            }
+        }
+        let mut events = driver.events.clone();
+        events.sort();
+        Ok(Self {
+            panicked: false,
+            root: tracker.root,
+            highest: tracker.highest_with_parent_ready,
+            st,
+            events,
+            leader_before: driver.leader_before.clone(),
+        })
+    }
+}
+
+/// Block ids must not conflict. `count` is how many blocks the instance has;
+/// there must be that many blocks, that many different ids, and that many
+/// different real blocks, and every real block must translate back to the
+/// model block it came from.
+fn check_ids(blocks: &BTreeSet<QBlock>, count: usize) -> Result {
+    ensure!(
+        blocks.len() == count,
+        "the instance should have {count} blocks but names {}: two blocks share a slot and an id",
+        blocks.len()
+    );
+    let ids: BTreeSet<u64> = blocks.iter().map(|block| block.id).collect();
+    ensure!(
+        ids.len() == count,
+        "block ids conflict: {count} blocks but only {} different ids",
+        ids.len()
+    );
+    let real: BTreeSet<Block> = blocks.iter().map(|block| block.to_block()).collect();
+    ensure!(
+        real.len() == count,
+        "real block ids conflict: {count} blocks but only {} different real blocks",
+        real.len()
+    );
+    for block in blocks {
+        ensure!(
+            QBlock::from_block(&block.to_block())? == *block,
+            "{block} does not survive the translation to a real block and back"
+        );
+    }
+    Ok(())
+}
+
+fn to_set(blocks: &[Block]) -> Result<BTreeSet<QBlock>> {
+    blocks.iter().map(QBlock::from_block).collect()
+}
+
+/// quint-connect requires the trait, but reads the model state through
+/// `from_spec` above, which picks the variables it needs.
+impl<'de> Deserialize<'de> for View {
+    fn deserialize<D: serde::Deserializer<'de>>(_: D) -> std::result::Result<Self, D::Error> {
+        Err(serde::de::Error::custom("View is read with from_spec"))
+    }
+}
