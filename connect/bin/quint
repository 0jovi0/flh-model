#!/bin/bash
# quint-connect starts `quint run` with one thread per core. Keep it at the cap.
REAL=/opt/ag-model/tools/quint/node_modules/.bin/quint
export PATH=/opt/ag-model/tools/node/bin:$PATH
if [ "${1:-}" = "run" ] && [[ " $* " != *" --n-threads"* ]]; then
  exec "$REAL" "$@" --n-threads="${Q_CPUS:-4}"
fi
exec "$REAL" "$@"
